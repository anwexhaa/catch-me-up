# Copy this file to .env.local and paste your key from https://aistudio.google.com/apikey
# Without a key the app still works and shows rule-based summaries instead of AI recaps.
GEMINI_API_KEY=

# Optional: comma-separated models to try in order (later ones are used if a model is rate limited).
GEMINI_MODEL=gemini-2.5-flash,gemini-2.5-flash-lite
